[Unit]
Description=Qwen3.8-27B NVFP4 + MTP + Vision (vLLM 0.29.0, RTX 5090)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/env bash %h/qwen-vllm/serve-qwen38-029.sh
Restart=on-failure
RestartSec=10
# First start may compile kernels; warm cache starts in ~2 min.
TimeoutStartSec=900
KillMode=mixed

# Boot autostart ENABLED 2026-09-19, when the server was opened to the home LAN:
# other machines need it up without someone first logging in here and pressing a
# button. This also requires user lingering, or the unit dies with the session:
#   sudo loginctl enable-linger "$USER"
#   systemctl --user enable qwen38
# To go back to the old manual-button behaviour: systemctl --user disable qwen38.

[Install]
WantedBy=default.target
